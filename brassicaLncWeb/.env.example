# Application Settings
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your.vm.ip.or.domain
APP_PORT=8000

# Container Process User/Group IDs (1000 for standard deployment)
APP_UID=1000
APP_GID=1000

# Database Configuration
DATABASE_NAME=brassica
DATABASE_USER=brassica
DATABASE_PASSWORD=change-me

# Security & Domain Configuration
CORS_ALLOWED_ORIGINS=https://brassica.arfadaei.ir
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://brassica.arfadaei.ir

# Application Features
SEED_DATABASE=true

# HTTPS / Cookie Security Settings (Enable when SSL/Reverse Proxy is ready)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0