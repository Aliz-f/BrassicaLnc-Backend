# Recommended: python3 deploy/deploy.py init api.example.com (from repo root).
# For manual setup, replace both placeholders with separate random secrets.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your.vm.ip.or.domain
APP_PORT=8000
APP_UID=1000
APP_GID=1000
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=brassica
DATABASE_USER=brassica
DATABASE_PASSWORD=change-me
DATABASE_HOST=database
DATABASE_PORT=5432
CORS_ALLOWED_ORIGINS=https://brassica.arfadaei.ir
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://brassica.arfadaei.ir
SEED_DATABASE=true
# Enable after HTTPS is working through host nginx.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
